# ── Serveur ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Données ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://goupyl:password@localhost:5432/goupyl_sport?schema=public"

# Sans REDIS_URL, config/redis.js bascule sur un MemoryStore : toutes les
# sessions et tous les refresh tokens sont perdus à chaque redemarrage.
REDIS_URL="redis://localhost:6379"

# ── Authentification ──────────────────────────────────────────────────────
# JWT_SECRET est lu par config/jwt.js, JWT_ACCESS_SECRET par utils/encryption.js.
# Garder les deux IDENTIQUES : leur divergence a deja provoque des 500 en prod.
JWT_SECRET="change_me_with_a_very_long_random_string_32_chars_min"
JWT_ACCESS_SECRET="change_me_with_a_very_long_random_string_32_chars_min"
JWT_REFRESH_SECRET="another_different_long_random_string_here"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Cle AES-256-GCM du questionnaire medical (donnees de sante, RGPD art. 9).
# Repli : JWT_ACCESS_SECRET, puis JWT_SECRET. Si aucune n'est definie,
# la soumission du PAR-Q renvoie 500.
PARQ_ENCRYPTION_KEY="yet_another_long_random_string_for_health_data"

# WebAuthn : doivent correspondre au domaine reellement servi.
PASSKEY_RP_ID="localhost"
PASSKEY_ORIGIN="http://localhost:5173"

# Google Sign-In (POST /auth/google) — laisser vide desactive le bouton.
GOOGLE_CLIENT_ID=""

# ── Origines ──────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"   # liens des emails + redirections Stripe

# ── Services tiers ────────────────────────────────────────────────────────
# Sans RESEND_API_KEY, config/email.js devient un no-op SILENCIEUX.
RESEND_API_KEY="re_your_resend_api_key"

# getStripe() est paresseux : sans cle, rien n'echoue au demarrage, les routes
# de paiement levent une erreur au premier appel.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
